#!name=Revenuecat-edit
#!desc=Revenuecat-edit

[Script]
http-response ^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts$|subscribers\/?(.*?)*$) script-path=https://raw.githubusercontent.com/Daniel0829/Collections/refs/heads/Scripts/Revenuecat-edit.js, requires-body=true, timeout=60, tag=Reheji

http-request ^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts$|subscribers\/?(.*?)*$) script-path=https://raw.githubusercontent.com/Daniel0829/Collections/refs/heads/Scripts/Revenuecat-edit.js, timeout=60, tag=Reheji

[MITM]
hostname = api.revenuecat.com, api.rc-backup.com
