[MITM]
hostname = %APPEND% appv2.filmix.com.cn, api.craft.do, *.grammarly.com, umeecorn.com, translator.felo.me, *.cloudfront.net, ftmailbox.cn, backend.getdrafts.com, zy6kcqa01a.execute-api.us-east-2.amazonaws.com, fl*app.com, api.hummingbird.businessreview.global, *.wps.cn, xremit.xcurrency.com, explorer.tratao.com, www.skyjos.cn, cubox.*, accounts.agenda.com, *.aoscdn.com, *.apsapp.cn, *.camscanner.com, mb3admin.com, *.cyapi.cn, buy.itunes.apple.com, api.rc-backup.com, api.revenuecat.com

