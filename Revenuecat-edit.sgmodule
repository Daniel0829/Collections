#!name=Revenuecat-edit
#!desc=Revenuecat-edit

[Script]
Revenuecat-edit = type=http-response, pattern=^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts$|subscribers\/?(.*?)*$), script-path=https://raw.githubusercontent.com/Daniel0829/Collections/refs/heads/Scripts/Revenuecat-edit.js, requires-body=true, max-size=-1, timeout=60

Revenuecat-edit = type=http-request, pattern=^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts$|subscribers\/?(.*?)*$), script-path=https://raw.githubusercontent.com/Daniel0829/Collections/refs/heads/Scripts/Revenuecat-edit.js, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com, api.rc-backup.com
