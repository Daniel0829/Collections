#!name=IPPure
#!desc=IPPure IP Info / Fraud Score / Native Check

[Panel]
# IPPure IP Info
ippure-ip-info = script-name=IP-Check, title="IPPure IP Info", content="请刷新", style=info, update-interval=1

# IPPure IP Fraud Score
ippure-ip-fraud = script-name=IPPure-IP-Fraud-Score, title="IPPure IP Fraud Score", content="请刷新", style=info, update-interval=1

# IPPure IP Native Check
ippure-ip-native = script-name=IPPure-IP-Native-Check, title="IPPure IP Native Check", content="请刷新", style=info, update-interval=1

[Script]
# IPPure IP Info 脚本
IP-Check = type=generic, timeout=3, script-path=https://fastly.jsdelivr.net/gh/StashNetworks/misc@main/collapsed-tiles/script/ippure-ip-info.js

# IPPure IP Fraud Score 脚本
IPPure-IP-Fraud-Score = type=generic, timeout=3, script-path=https://fastly.jsdelivr.net/gh/StashNetworks/misc@main/collapsed-tiles/script/ippure-ip-fraud-score.js

# IPPure IP Native Check 脚本
IPPure-IP-Native-Check = type=generic, timeout=3, script-path=https://fastly.jsdelivr.net/gh/StashNetworks/misc@main/collapsed-tiles/script/ippure-ip-native-check.js

